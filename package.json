{
  "name": "lyrics-island-windows",
  "version": "0.1.1-beta.4",
  "engines": { "node": ">=24.12.0" },
  "description": "A floating Dynamic-Island-style Spotify lyrics notch for Windows.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "test:desktop": "electron scripts/desktop-check.cjs",
    "pack": "electron-packager . \"Lyrics Island\" --platform=win32 --arch=x64 --icon=assets/lyrics-island.ico --out=release --overwrite --ignore=release --ignore=.git",
    "dist": "electron-builder --win nsis portable"
  },
  "keywords": [
    "spotify",
    "lyrics",
    "windows",
    "electron",
    "dynamic-island"
  ],
  "author": "Garv Rao",
  "license": "MIT",
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.9"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.garvrao.lyricsisland",
    "productName": "Lyrics Island",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/lyrics-island.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "LyricsIsland-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "LyricsIsland-Portable-${version}-${arch}.${ext}"
    }
  }
}
